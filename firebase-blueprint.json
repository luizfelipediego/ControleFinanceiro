{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "Perfil dos usuários cadastrados no sistema",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "caixa_permissao": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "receitas": {
      "title": "Receitas",
      "description": "Entradas financeiras registradas",
      "type": "object",
      "properties": {
        "data": { "type": "string" },
        "origem": { "type": "string" },
        "valor": { "type": "number" },
