      "required": ["data", "origem", "valor", "caixa"]
    },
    "despesas": {
      "title": "Despesas",
      "description": "Saídas financeiras registradas",
      "type": "object",
      "properties": {
        "data_compra": { "type": "string" },
        "data_competencia": { "type": "string" },
        "categoria_id": { "type": "number" },
        "descricao": { "type": "string" },
        "valor": { "type": "number" },
